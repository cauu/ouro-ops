{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ouro.example/schemas/release-catalog.schema.json",
  "title": "Ouro signed Blink Labs release catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "allowlist_version",
    "signature",
    "repository",
    "recommended",
    "contracts",
    "denylist",
    "transitions"
  ],
  "properties": {
    "allowlist_version": { "type": "integer", "minimum": 1 },
    "signature": { "type": "string", "pattern": "^ed25519:[0-9a-f]{128}$" },
    "repository": { "const": "ghcr.io/blinklabs-io/cardano-node" },
    "recommended": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/digest" },
      "propertyNames": { "enum": ["linux/amd64", "linux/arm64"] }
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/contract" }
    },
    "denylist": {
      "type": "array",
      "items": { "$ref": "#/$defs/digest" },
      "uniqueItems": true
    },
    "transitions": {
      "type": "array",
      "items": { "$ref": "#/$defs/transition" }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "convention_version",
        "contract_id",
        "in_container_paths",
        "role_rules",
        "allowed"
      ],
      "properties": {
        "convention_version": { "type": "integer", "minimum": 1 },
        "contract_id": { "type": "string", "minLength": 1 },
        "in_container_paths": {
          "type": "object",
          "additionalProperties": false,
          "required": ["socket", "db", "keys", "config", "topology", "genesis"],
          "properties": {
            "socket": { "$ref": "#/$defs/absolutePath" },
            "db": { "$ref": "#/$defs/absolutePath" },
            "keys": { "$ref": "#/$defs/absolutePath" },
            "config": { "$ref": "#/$defs/absolutePath" },
            "topology": { "$ref": "#/$defs/absolutePath" },
            "genesis": { "$ref": "#/$defs/absolutePath" }
          }
        },
        "role_rules": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bp", "relay"],
          "properties": {
            "bp": { "$ref": "#/$defs/roleRule" },
            "relay": { "$ref": "#/$defs/roleRule" }
          }
        },
        "deploy": { "$ref": "#/$defs/deployBootstrap" },
        "allowed": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/image" }
        }
      }
    },
    "absolutePath": { "type": "string", "pattern": "^/" },
    "roleRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_opcert", "forbids_forging_keys"],
      "properties": {
        "requires_opcert": { "type": "boolean" },
        "forbids_forging_keys": { "type": "boolean" }
      }
    },
    "deployBootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_binaries",
        "entrypoint",
        "args",
        "database_marker",
        "metrics",
        "environment",
        "networks"
      ],
      "properties": {
        "required_binaries": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 5,
          "uniqueItems": true
        },
        "entrypoint": { "$ref": "#/$defs/absolutePath" },
        "args": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "database_marker": { "$ref": "#/$defs/absolutePath" },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["container_port", "host_ip", "host_port"],
          "properties": {
            "container_port": { "const": 12798 },
            "host_ip": { "const": "127.0.0.1" },
            "host_port": { "const": 12798 }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "network",
            "topology",
            "database",
            "socket",
            "block_producer",
            "restore_snapshot"
          ],
          "properties": {
            "network": { "const": "CARDANO_NETWORK" },
            "topology": { "const": "CARDANO_TOPOLOGY" },
            "database": { "const": "CARDANO_DATABASE_PATH" },
            "socket": { "const": "CARDANO_SOCKET_PATH" },
            "block_producer": { "const": "CARDANO_BLOCK_PRODUCER" },
            "restore_snapshot": { "const": "RESTORE_SNAPSHOT" }
          }
        },
        "networks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mainnet", "preprod", "preview"],
          "properties": {
            "mainnet": { "$ref": "#/$defs/deployNetwork" },
            "preprod": { "$ref": "#/$defs/deployNetwork" },
            "preview": { "$ref": "#/$defs/deployNetwork" }
          }
        }
      }
    },
    "deployNetwork": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config",
        "config_sha256",
        "topology",
        "genesis",
        "genesis_hash",
        "genesis_vkey",
        "ancillary_vkey",
        "mithril_aggregator",
        "bootstrap_peers",
        "min_memory_bytes",
        "min_free_disk_bytes"
      ],
      "properties": {
        "config": { "$ref": "#/$defs/absolutePath" },
        "config_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "topology": { "$ref": "#/$defs/absolutePath" },
        "genesis": { "$ref": "#/$defs/absolutePath" },
        "genesis_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "genesis_vkey": { "$ref": "#/$defs/absolutePath" },
        "ancillary_vkey": { "$ref": "#/$defs/absolutePath" },
        "mithril_aggregator": {
          "type": "string",
          "pattern": "^https://aggregator\\..+\\.api\\.mithril\\.network/aggregator$"
        },
        "bootstrap_peers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["address", "port"],
            "properties": {
              "address": {
                "type": "string",
                "pattern": "^[A-Za-z0-9.:-]+$"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          }
        },
        "min_memory_bytes": { "type": "integer", "minimum": 1 },
        "min_free_disk_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "platform",
        "oci_index_digest",
        "platform_manifest_digest",
        "image_config_digest"
      ],
      "properties": {
        "release": { "type": "string", "minLength": 1 },
        "platform": { "enum": ["linux/amd64", "linux/arm64"] },
        "oci_index_digest": { "$ref": "#/$defs/digest" },
        "platform_manifest_digest": { "$ref": "#/$defs/digest" },
        "image_config_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_image_config_digest",
        "to_image_config_digest",
        "db_forward_compatible",
        "db_backward_compatible",
        "snapshot_taken"
      ],
      "properties": {
        "from_image_config_digest": { "$ref": "#/$defs/digest" },
        "to_image_config_digest": { "$ref": "#/$defs/digest" },
        "db_forward_compatible": { "type": "boolean" },
        "db_backward_compatible": { "type": "boolean" },
        "snapshot_taken": { "type": "boolean" }
      }
    }
  }
}
