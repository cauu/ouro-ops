// Fixed assets-only production Worker for the public Ouro Ops onboarding page.
// There is no preview or server-side application path.
{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "ouro-ops-site",
  "compatibility_date": "2026-07-18",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
