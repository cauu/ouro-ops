#!/bin/sh
# S0015 p3 — the ONLY tool surface exposed to the real LLM agent (E2E-8 real-agent branch).
# It is a thin, LOGGED wrapper over `ouro-ops tool run`: the agent operates by choosing which tool to
# invoke (guided by the skills' SKILL.md), and every invocation is appended to a transcript that
# the driver-agnostic invariant asserter consumes — exactly like the scripted driver's transcript.
# The agent is given NO other way to touch the machines, so its decisions (not the harness) are
# what is under test; the §2.2 invariants must hold regardless of what it chooses.
ouro-ops tool run "$@" > /tmp/agent-out.json 2>/tmp/agent-err.txt
rc=$?
python3 - "$rc" "$@" <<'PY'
import json, sys, time
rc = int(sys.argv[1]); argv = sys.argv[2:]
machine = None
for i, a in enumerate(argv):
    if a == "--dispatch" and i + 1 < len(argv):
        machine = argv[i + 1]
try:
    out = json.load(open("/tmp/agent-out.json"))
except Exception:
    out = None
open("/tmp/agent-transcript.jsonl", "a").write(json.dumps({
    "kind": "tool", "scenario": "agent", "tool": argv[0] if argv else "?",
    "machine": machine, "exit": rc, "ts": time.time(), "output": out}) + "\n")
PY
cat /tmp/agent-out.json
exit $rc
