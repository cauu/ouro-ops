limit_req_zone $binary_remote_addr zone=ouro_ops_api_rl:10m rate=5r/s;

server {
  listen {{ ops_metrics_gateway_listen_port }} ssl http2;
  server_name {{ ops_metrics_gateway_server_name }};

  ssl_certificate {{ ops_metrics_tls_cert_path }};
  ssl_certificate_key {{ ops_metrics_tls_key_path }};
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;

  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;

  location = /_ops_auth {
    internal;
    auth_basic "{{ ops_metrics_basic_auth_realm }}";
    auth_basic_user_file {{ ops_metrics_htpasswd_path }};
    return 204;
  }

  location = /api/ops/v1/telemetry/raw {
    if ($args != "") { return 400; }
    auth_request /_ops_auth;
    limit_req zone=ouro_ops_api_rl burst=20 nodelay;
    proxy_pass {{ ops_metrics_prometheus_upstream }}/api/v1/query?query=%7B__name__%3D~%22.%2B%22%7D;
  }

  location / {
    return 404;
  }
}
